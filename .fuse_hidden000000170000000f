<script>
  const toggle = document.getElementById('menuToggle');
  const links = document.getElementById('navLinks');
  toggle?.addEventListener('click', () => links.classList.toggle('open'));
  document.querySelectorAll('#navLinks a').forEach(a => {
    a.addEventListener('click', () => links.classList.remove('open'));
  });

  // Hero fade-on-scroll
  (function() {
    const hero = document.getElementById('heroPhoto');
    const heroContent = document.getElementById('heroPhotoContent');
    const scrollCue = document.querySelector('.hero-scroll-cue');
    if (!hero || !heroContent) return;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let ticking = false;

    function update() {
      const heroHeight = hero.offsetHeight || window.innerHeight;
      const fadeDistance = heroHeight * 0.75;
      const progress = Math.min(Math.max(window.scrollY / fadeDistance, 0), 1);
      heroContent.style.opacity = String(1 - progress);
      if (!reduceMotion) {
        heroContent.style.transform = 'translateY(' + (progress * 40) + 'px)';
      }
      if (scrollCue) {
        scrollCue.style.opacity = String(Math.max(1 - progress * 4, 0));
      }
      ticking = false;
    }

    window.addEventListener('scroll', function() {
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    }, { passive: true });

    update();
  })();

  // Carousel
  (function() {
    const track = document.getElementById('carouselTrack');
    const dotsContainer = document.getElementById('carouselDots');
    if (!track || !dotsContainer) return;

    // Filter out broken images before initialising
    function filterBroken() {
      return new Promise(resolve => {
        const images = Array.from(track.querySelectorAll('img'));
        let pending = images.length;
        if (!pending) return resolve();
        images.forEach(img => {
          const finalize = () => {
            if (img.naturalWidth === 0 || img.naturalHeight === 0) {
              const slide = img.closest('.carousel-slide');
              if (slide && slide.parentNode) slide.parentNode.removeChild(slide);
            }
            if (--pending === 0) resolve();
          };
          if (img.complete) finalize();
          else {
            img.addEventListener('load', finalize, { once: true });
            img.addEventListener('error', finalize, { once: true });
          }
        });
      });
    }

    filterBroken().then(initCarousel);

    function initCarousel() {
      const slides = track.children;
      const total = slides.length;
      if (total === 0) {
        const section = document.querySelector('.carousel-section');
        if (section) section.style.display = 'none';
        return;
      }
      let current = 0;
      let interval;

      for (let i = 0; i < total; i++) {
        const dot = document.createElement('button');
        dot.className = 'carousel-dot' + (i === 0 ? ' active' : '');
        dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
        dot.addEventListener('click', () => { stopAuto(); go(i); startAuto(); });
        dotsContainer.appendChild(dot);
      }
      const dots = dotsContainer.children;

      function update() {
        track.style.transform = 'translateX(-' + (current * 100) + '%)';
        for (let i = 0; i < dots.length; i++) {
          dots[i].classList.toggle('active', i === current);
        }
      }
      function go(i) { current = (i + total) % total; update(); }
      function next() { go(current + 1); }
      function prev() { go(current - 1); }

      document.getElementById('carouselNext').addEventListener('click', () => { stopAuto(); next(); startAuto(); });
      document.getElementById('carouselPrev').addEventListener('click', () => { stopAuto(); prev(); startAuto(); });

      function startAuto() { interval = setInterval(next, 5000); }
      function stopAuto() { if (interval) clearInterval(interval); }
      startAuto();

      const frame = document.querySelector('.carousel-frame');
      if (frame) {
        frame.addEventListener('mouseenter', stopAuto);
        frame.addEventListener('mouseleave', startAuto);
      }
    }
  })();
</script>

</body>
</html>
